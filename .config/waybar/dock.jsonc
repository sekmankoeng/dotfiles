[
  {
    "name": "dock",
    "layer": "top",
    "position": "bottom",
    "height": 46,
    "mode": "dock",
    "margin": "2px",
    "spacing": 2,
    
    "modules-left": [
      "custom/os_button"
    ],
    
    "modules-center": [
      "wlr/taskbar"
    ],
    
    "custom/os_button": {
      // "format": "🔍",
      "format": "",
      "icon-size": 36,
      "spacing": 2,
      "on-click": "niri msg action spawn -- fuzzel --show drun",
      "tooltip": false
    },
    
    "wlr/taskbar": {
      "format": "{icon}",
      "icon-size": 36,
      "spacing": 2,
      "on-click-middle": "close",
      "tooltip-format": "{title}",
      "ignore-list": ["wofi", "fuzzel"],
      "on-click": "activate"
    }
  }
]
