[
  {
    "name": "dock",
    "layer": "top",
    "position": "bottom",
    "height": 46,
    "width": 128,
    "margin": "2px",
    "spacing": 2,
    "expand-center": false,
    "expand-left": false,
    "expand-right": false,
    "fixed-center": true,
    "modules-left": [],
    "modules-center": [
      "custom/spotlight",
      "custom/nautilus",
      "custom/separator",
      "wlr/taskbar",
      "custom/separator",
      "custom/trash"
    ],
    "modules-right": [],

    "custom/spotlight": {
      "format": "",
      "icon-size": 36,
      "spacing": 2,
      "on-click": "niri msg action spawn -- fuzzel --show drun",
      "tooltip": false
    },
    
    "custom/nautilus": {
      "format": "󰀶",
      "icon-size": 36,
      "spacing": 2,
      "on-click": "niri msg action spawn -- nautilus",
      "tooltip": false
    },

    "custom/separator": {
      "format": "",
      "icon-size": 36,
      "spacing": 2,
      "tooltip": false
    },

    "custom/trash": {
      "format": "󰩺",
      "icon-size": 36,
      "spacing": 2,
      "on-click": "niri msg action spawn -- nautilus trash://",
      "tooltip": false
    },
    "wlr/taskbar": {
      "format": "{icon}",
      "icon-size": 36,
      "spacing": 2,
      "on-click-middle": "close",
      "tooltip-format": "{title}",
      "ignore-list": ["wofi", "fuzzel"],
      "squash-list": ["*"],
      "on-click": "activate",
      "tooltip": false
    }
  }
]
